    {
      "parameters": {
        "jsCode": "// Ambil semua input\nconst inputData = $input.all();\n\n// Pastikan semua jadi array\nconst allRows = inputData.flatMap(item =>\n  Array.isArray(item.json) ? item.json : [item.json]\n);\n\n// Mapping data dengan nama field yang BENAR\nconst result = allRows.map(row => {\n  return {\n    \"ID Laporan\": row['ID Laporan'] ?? '',\n    \"Bulan\": row['Bulan'] ?? '',\n    \"Produk\": row['Produk'] ?? '',\n    \"Wilayah\": row['Wilayah'] ?? '-',\n    \"Penjualan (Unit)\": row['Penjualan (Unit)'] ?? 0,\n    \"Target (Unit)\": row['Target (Unit)'] ?? 0,\n    \"Pendapatan (IDR)\": row['Pendapatan (IDR)'] ?? 0,\n    \"Status\": row['Status'] ?? 'Tidak Diketahui',\n    \"Keterangan\": row['Keterangan'] ?? '',\n    \"Tanggal Laporan\": row['Tanggal Laporan'] ?? '',\n    \"Sumber\": row['Sumber'] ?? 'Sheet3'\n  };\n});\n\n// Return ke n8n\nreturn result.map(item => ({ json: item }));"
      },
